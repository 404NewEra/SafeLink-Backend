# 쉼표로 구분합니다. 운영 환경에서는 실제 프론트엔드 주소만 허용하세요.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# 기상청 APIHub 마이페이지에서 발급받은 인증키를 입력하세요.
KMA_AUTH_KEY=
KMA_API_URL=https://apihub.kma.go.kr/api/typ01/url/sfc_nc_var.php
KMA_API_TIMEOUT_SECONDS=10

# MVP 입력/출력 지역과 실제 데이터 파일 경로입니다.
MVP_REGION_PREFIX=서울특별시
LANDSLIDE_HISTORY_CSV_PATH=C:/path/to/산림청_최근 5년간 전국 산사태 발생 이력_20250101.csv
LANDSLIDE_RISK_RASTER_PATH=C:/path/to/41.tif
DEM_RASTER_PATH=C:/path/to/한반도90m_GRS80.img
SHELTER_CSV_PATH=C:/path/to/서울특별시_산사태 임시대피소 현황_20230614.csv
SHELTER_RAG_TOP_K=5

# 추후 LLM 연동 시 사용합니다. 실제 키는 .env에만 저장하세요.
LLM_API_KEY=
LLM_MODEL=
# OpenAI 호환 API를 사용하는 경우에만 입력합니다. 공식 OpenAI는 비워 두세요.
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30

# 추후 학습된 Random Forest 파일 경로를 지정할 수 있습니다.
RANDOM_FOREST_MODEL_PATH=
